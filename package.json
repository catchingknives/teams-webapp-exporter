{
  "name": "teams-chat-exporter",
  "version": "1.0.0",
  "type": "module",
  "description": "Export all MS Teams chats to Markdown via Playwright browser automation",
  "scripts": {
    "export": "npx tsx export-all.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "sbom": "npm sbom --sbom-format cyclonedx --omit=dev > sbom.cdx.json"
  },
  "dependencies": {
    "playwright-core": "1.64.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "eslint": "^9.39.5",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
