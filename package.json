{
  "name": "teams-chat-exporter",
  "version": "1.0.0",
  "type": "module",
  "description": "Export all MS Teams chats to Markdown via Playwright browser automation",
  "scripts": {
    "export": "npx tsx export-all.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "sbom": "npm sbom --sbom-format cyclonedx --omit=dev > sbom.cdx.json"
  },
  "dependencies": {
    "playwright-core": "1.60.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "eslint": "^9.39.4",
    "tsx": "4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8"
  }
}
